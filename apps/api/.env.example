# Supabase Postgres connection strings.
# DATABASE_URL: Transaction pooler URI (port 6543) — MUST include ?pgbouncer=true
#   or Prisma will throw: prepared statement "s0" already exists.
# DIRECT_URL: Direct connection URI (port 5432) — used by prisma migrate + smoke tests.
#
# If special characters are in the password, URL-encode them (e.g. @ → %40).
# Copy fresh URIs from: Supabase → Project Settings → Database → Connect.
DATABASE_URL="postgresql://postgres:password@localhost:6543/civic_platform?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/civic_platform"

PORT=4000

# Any long random string for signing JWTs — e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"

# Google AI Studio key for Gemini (https://aistudio.google.com/apikey).
# If unset, classification silently falls back to the keyword classifier.
GEMINI_API_KEY=""
# Optional override, defaults to gemini-3.6-flash.
GEMINI_MODEL=""
# Optional override, defaults to gemini-embedding-2. Used for duplicate
# detection's semantic-similarity stage.
GEMINI_EMBEDDING_MODEL=""
