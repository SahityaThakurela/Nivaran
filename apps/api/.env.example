# Supabase Postgres connection strings.
# DATABASE_URL: "Connection pooling" string — used by the running app.
# DIRECT_URL: direct (non-pooled) connection — used only by `prisma migrate`.
DATABASE_URL="postgresql://postgres:password@localhost:6543/civic_platform"
DIRECT_URL="postgresql://postgres:password@localhost:5432/civic_platform"

PORT=4000

# Any long random string for signing JWTs — e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"
