# Supabase Postgres connection strings.
# DATABASE_URL: Transaction pooler URI (port 6543) — MUST include ?pgbouncer=true
#   or Prisma will throw: prepared statement "s0" already exists.
# DIRECT_URL: Direct connection URI (port 5432) — used by prisma migrate + smoke tests.
#
# If special characters are in the password, URL-encode them (e.g. @ → %40).
# Copy fresh URIs from: Supabase → Project Settings → Database → Connect.
DATABASE_URL="postgresql://postgres:password@localhost:6543/civic_platform?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/civic_platform"

PORT=4000

# Public origin of this API (used to build absolute photo URLs for mobile/web).
# Example: https://nivaran-m0b2.onrender.com
PUBLIC_API_URL="http://localhost:4000"

# Any long random string for signing JWTs — e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"

# Cloudinary (https://console.cloudinary.com) — preferred: three separate values
# from Dashboard -> API Keys (do not use CLOUDINARY_URL when these are set).
# Photos fall back to Postgres when unset or misconfigured.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional single-string alternative (leave unset if using the three vars above):
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# OpenRouter (https://openrouter.ai/keys) — used for report classification + embeddings.
# If unset, classification falls back to the keyword classifier and embeddings are skipped.
OPENROUTER_API_KEY=""
# Optional chat model override (default: google/gemini-2.5-flash).
OPENROUTER_MODEL=""
# Optional embedding model override (default: openai/text-embedding-3-small @ 768 dims).
OPENROUTER_EMBEDDING_MODEL=""
# Optional ranking metadata sent to OpenRouter (not secrets).
OPENROUTER_HTTP_REFERER="http://localhost:4000"
OPENROUTER_APP_TITLE="Nivaran Civic Platform"
